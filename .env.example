# Supabase (optional) - enables shared, persistent task storage.
# Without these, PatchPilot falls back to browser localStorage.
# Use the project URL and a CLIENT-SAFE key: either the new publishable key
# (sb_publishable_...) or the legacy anon key. NEVER use the secret/service_role
# key here - it must never reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred (new format):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Or legacy anon key (either one works):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (optional) - enables real AI brief generation via /api/brief.
# Without this, a deterministic offline template brief is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cursor Cloud Agents (optional) - enables the "Dispatch real agent" button,
# which launches a real background agent on your repo via the Cursor API.
# Create a user key at Cursor Dashboard -> Integrations -> API Keys.
# SERVER-ONLY: never expose this to the browser.
CURSOR_API_KEY=
# Repo the agent works on (and its starting branch/ref).
CURSOR_TARGET_REPO=https://github.com/Cashubski/CursorHack
CURSOR_TARGET_REF=main
